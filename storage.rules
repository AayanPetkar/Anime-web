rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // avatars/{uid}/... — profile pictures. Owner-only writes; publicly
    // readable (avatars render in the navbar/profile for anyone viewing a
    // shared profile), capped at 5MB and image content-types only.
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
